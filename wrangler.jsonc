{
  "name": "go-together",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BRAIN_AUTH_MODE": "DIRECT",
    "ACCESS_AUD": "6b7b2007c1ae1b5e9215681bc94fd1b41edf3c6d4c87d3afebda01afd69c2dc8",
    "ACCESS_TEAM_DOMAIN": "pureekangraw.cloudflareaccess.com",
    "OWNER_EMAIL": "pureekangraw@gmail.com"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/*",
      "/auth/*",
      "/oauth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-together",
      "database_id": "b236c05f-e07f-498b-a9d5-ccefe8be5f22"
    }
  ],
  "services": [
    {
      "binding": "PANTHEON",
      "service": "phatheon-workhub"
    },
    {
      "binding": "PANTHEON_OWNER",
      "service": "phatheon-workhub",
      "entrypoint": "OwnerBridge"
    },
    {
      "binding": "PRYTANEION_DIRECT",
      "service": "prytaneion-explorer",
      "entrypoint": "HubDirectRead"
    }
  ]
}
