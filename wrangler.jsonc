{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-together",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-together",
      "database_id": "b236c05f-e07f-498b-a9d5-ccefe8be5f22"
    }
  ]
}
